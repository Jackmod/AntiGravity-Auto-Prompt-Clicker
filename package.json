{
  "name": "auto-picker",
  "productName": "Auto Picker",
  "version": "1.0.0",
  "description": "Watches your screen and auto-confirms Claude Code 'Yes' approval prompts in the Antigravity IDE — pausing the moment it sees anything it doesn't recognize.",
  "author": "Auto Picker contributors",
  "license": "MIT",
  "main": "src/main/main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "electron-store": "^8.2.0",
    "jimp": "^0.22.12",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.autopicker.app",
    "productName": "Auto Picker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@nut-tree-fork/**/*",
      "**/node_modules/tesseract.js*/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "AutoPicker-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "AutoPicker-${version}-${arch}.${ext}"
    }
  }
}
